  FNNAVAnalChartData in '..\Sources\MXPackage\NAVAnalisys\FNNAVAnalChartData.pas',
  FNNAVAnalChartDataSeries in '..\Sources\MXPackage\NAVAnalisys\FNNAVAnalChartDataSeries.pas',
  FNNAVAnalChartDefine in '..\Sources\MXPackage\NAVAnalisys\FNNAVAnalChartDefine.pas',
  FNNAVAnalChartTraceEvent in '..\Sources\MXPackage\NAVAnalisys\FNNAVAnalChartTraceEvent.pas',
  FNNAVAnalColorSet in '..\Sources\MXPackage\NAVAnalisys\FNNAVAnalColorSet.pas',
  FNNAVAnalConst in '..\Sources\MXPackage\NAVAnalisys\FNNAVAnalConst.pas',
