  FNAccountData in '..\Sources\MXPackage\FNAccountData.pas',
  FNChildFrameCustom in '..\Sources\MXPackage\FNChildFrameCustom.pas' {ChildFrameCustom: TFrame},
  FNTickerItem in '..\Sources\MXPackage\FNTickerItem.pas',
  FNControlColorSet in '..\Sources\MXPackage\FNControlColorSet.pas',
  FNTradeSystem in '..\Sources\MXPackage\TradeSystem\FNTradeSystem.pas',
  FNTrafficManager in '..\Sources\MXPackage\TradeSystem\FNTrafficManager.pas',
  MXSumaryOption in '..\Sources\MXPackage\Matrix\Block\MXSumaryOption.pas',
  MXBlock in '..\Sources\MXPackage\Matrix\Block\MXBlock.pas',
  MXSystemManager in '..\Sources\MXPackage\Matrix\Block\MXSystemManager.pas',
  FNMatrixChartBlock in '..\Sources\MXPackage\Matrix\Chart\FNMatrixChartBlock.pas',
  FNMatrixChartBlockManager in '..\Sources\MXPackage\Matrix\Chart\FNMatrixChartBlockManager.pas',
  FNMatrixChartControl in '..\Sources\MXPackage\Matrix\Chart\FNMatrixChartControl.pas',
  FNMatrixChartControlBase in '..\Sources\MXPackage\Matrix\Chart\FNMatrixChartControlBase.pas',
  FNMatrixChartDefine in '..\Sources\MXPackage\Matrix\Chart\FNMatrixChartDefine.pas',
  FNMatrixChartTraceEvent in '..\Sources\MXPackage\Matrix\Chart\FNMatrixChartTraceEvent.pas',
  FNMatrixColorSet in '..\Sources\MXPackage\Matrix\Chart\FNMatrixColorSet.pas',
  FNMatrixConst in '..\Sources\MXPackage\Matrix\Chart\FNMatrixConst.pas',
  FNMatrixLineValueSeriesCreator in '..\Sources\MXPackage\Matrix\Chart\FNMatrixLineValueSeriesCreator.pas',
  FNMatrixManageChartControl in '..\Sources\MXPackage\Matrix\Chart\FNMatrixManageChartControl.pas',
  FNMatrixMergeChartControl in '..\Sources\MXPackage\Matrix\Chart\FNMatrixMergeChartControl.pas',
  FNMatrixPosInfo in '..\Sources\MXPackage\Matrix\Chart\FNMatrixPosInfo.pas',
  FNMatrixPosValue in '..\Sources\MXPackage\Matrix\Chart\FNMatrixPosValue.pas',
  FNVolumePriceArray in '..\Sources\MXPackage\FNVolumePriceArray.pas',
  FNVolumePriceData in '..\Sources\MXPackage\FNVolumePriceData.pas',
  FNVPSummaryArray in '..\Sources\MXPackage\FNVPSummaryArray.pas',
  FNVPSummaryData in '..\Sources\MXPackage\FNVPSummaryData.pas',
  MXOrderManager in '..\Sources\MXPackage\Matrix\Block\MXOrderManager.pas',
  MXBlockManager in '..\Sources\MXPackage\Matrix\Block\MXBlockManager.pas',
  FNVirtualTradeManager in '..\Sources\MXPackage\FNVirtualTradeManager.pas',
  FNReceiveSensor in '..\Sources\MXPackage\FNReceiveSensor.pas',
  FNMatrixLineValueSeries in '..\Sources\MXPackage\Matrix\Chart\FNMatrixLineValueSeries.pas',
  FNNAVAnalChartBlock in '..\Sources\MXPackage\NAVAnalisys\FNNAVAnalChartBlock.pas',
