[TRINFO]
TRName=국내정정주문
TRCode=g12001.DO1901&;
ScreenNo=		; 실제 화면 번호
Server=1		; 접속 서버
Compress=0		; 압축 	0/1
Encrypt=1		; 암호화	0/1
PublicAuth=1	; 공인인증 0/1
OutputCnt=0		;Fid 출력값 갯수
DataHeader=4	; 2:해외주문, 3:해외조회, 4:국내주문, 5:국내조회

[INPUT]
계좌번호 =  0, 11, 0, A
비밀번호 = 11,  8, 0, E
종목코드 = 19, 32, 0, A;
매매구분 = 51,  1, 0, A;1매수, 2매도
주문유형 = 52,  1, 0, A;1.지정가, 2시장가
체결조건 = 53,  1, 0, A;1:FAS, 2:FOK, 3:FAK
주문가격 = 54, 13, 0, A;12345형태(소수점 없음)
주문수량 = 67,  5, 0, A
주문번호 = 72,  7, 0, A

[OUTPUT]

@START_OutRec1=1
	접수구분 =  0,  1, 0, A	;0:SYSTEM, 1:거래소
	처리구분 =  1,  1, 0, A ;0:정상처리, 1:오류
	계좌번호 =  2, 11, 0, A
	주문번호 = 13,  7, 0, A
	종목코드 = 20, 32, 0, A
@END_OutRec1

