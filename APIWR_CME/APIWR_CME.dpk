package APIWR_CME;

{$R *.res}
{$R '..\Sources\APIWR_CME\Agent\COMMOCXLib_TLB.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  xmlrtl,
  inet,
  IndyCore,
  IndySystem,
  IndyProtocols,
  DCPdelphi2009,
  CMPackage,
  MXPackage;

contains
  COMMOCXLib_TLB in '..\Sources\APIWR_CME\Agent\COMMOCXLib_TLB.pas',
  FNWROAgentManager in '..\Sources\APIWR_CME\Core\FNWROAgentManager.pas',
  WROIOMaker in '..\Sources\APIWR_CME\DataModel\WROIOMaker.pas';

end.
